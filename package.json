{
  "name": "rss-video-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "文章、视频与播客的 RSS 内容收件箱：统一时间流阅读、站内观看与持续收听。",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "test": "node --test server/db.test.js",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@extractus/article-extractor": "^9.0.1",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
